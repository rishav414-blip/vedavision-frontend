{
  "system": "VedaVision",
  "version": "1.0.0",
  "architecture": {
    "frontend": {
      "framework": "React 18 + Vite 5",
      "styling": {
        "base": "CSS custom properties (design tokens)",
        "utility_layer": "Tailwind CSS 3.x",
        "theme_tokens": {
          "--color-saffron": "#E8690B",
          "--color-deep-maroon": "#4A0E0E",
          "--color-gold": "#C9A84C",
          "--color-ivory": "#FAF6EE",
          "--color-night-sky": "#0D0D2B",
          "--color-green-auspicious": "#2D7A4F",
          "--color-red-inauspicious": "#C0392B",
          "--font-serif": "Cormorant Garamond, serif",
          "--font-sans": "Inter, sans-serif"
        }
      },
      "state_management": {
        "library": "Zustand 4.x",
        "stores": {
          "chartStore": {
            "state_fields": ["chartData", "currentDasha", "selectedHouse", "timeSliderPosition", "isCalculating"],
            "actions": ["setChartData", "setTimeSliderPosition", "selectHouse", "resetChart"]
          },
          "userStore": {
            "state_fields": ["profile", "subscriptionTier", "altarSessions", "greenRedCache"],
            "actions": ["setProfile", "setSubscriptionTier", "addAltarSession", "setGreenRedCache"]
          },
          "uiStore": {
            "state_fields": ["activeModal", "upsellTrigger", "isGateVisible", "toastQueue"],
            "actions": ["openModal", "closeModal", "triggerUpsell", "showToast"]
          }
        }
      },
      "routing": {
        "library": "React Router v6",
        "routes": [
          { "path": "/", "component": "LandingPage", "auth_required": false },
          { "path": "/chart", "component": "ChartInputPage", "auth_required": false },
          { "path": "/chart/:chartId", "component": "ChartDashboard", "auth_required": false },
          { "path": "/chart/:chartId/forecast", "component": "ForecastPage", "auth_required": true, "min_tier": "dharma_pass" },
          { "path": "/chart/:chartId/green-red", "component": "GreenRedCalendarPage", "auth_required": false },
          { "path": "/altar", "component": "DigitalAltarPage", "auth_required": true, "min_tier": "free" },
          { "path": "/dashboard", "component": "UserDashboard", "auth_required": true, "min_tier": "free" },
          { "path": "/pricing", "component": "PricingPage", "auth_required": false },
          { "path": "/login", "component": "AuthPage", "auth_required": false },
          { "path": "/admin", "component": "AdminPanel", "auth_required": true, "min_tier": "jyotishi_pro" }
        ]
      },
      "key_components": {
        "LagnaChartSVG": {
          "description": "North Indian diamond-grid or South Indian square-grid Kundali SVG renderer",
          "props_interface": {
            "chartData": "ChartData",
            "style": "'north_indian' | 'south_indian'",
            "highlightedHouse": "number | null",
            "highlightedPlanets": "PlanetId[]",
            "onHouseClick": "(houseNumber: number) => void",
            "size": "number",
            "showAspects": "boolean",
            "animateTransit": "boolean",
            "transitChartData": "ChartData | null"
          }
        },
        "TimeSlider": {
          "description": "Drag-scrub timeline that morphs the Kundali from birth to selected date in real time",
          "props_interface": {
            "birthDate": "string",
            "currentDate": "string",
            "maxDate": "string",
            "frames": "TimeSliderFrame[]",
            "onDateChange": "(isoDate: string) => void",
            "dashaMarkers": "DashaMarker[]",
            "isLocked": "boolean",
            "lockedUntilTier": "SubscriptionTierKey"
          }
        },
        "GreenRedCalendar": {
          "description": "Monthly calendar view showing auspicious (green) and inauspicious (red) days",
          "props_interface": {
            "month": "number",
            "year": "number",
            "days": "GreenRedDay[]",
            "onDayClick": "(day: GreenRedDay) => void",
            "viewMode": "'month' | 'week'",
            "freePreviewDays": "number",
            "isGated": "boolean",
            "onGateHit": "() => void"
          }
        },
        "HardTruthsSection": {
          "description": "Gated section surfacing difficult astrological assessments (afflictions, karmic debt, timing warnings)",
          "props_interface": {
            "hardTruths": "HardTruth[]",
            "isUnlocked": "boolean",
            "triggerContext": "HardTruthTriggerContext",
            "onUnlockClick": "() => void",
            "blurIntensity": "'light' | 'heavy'"
          }
        },
        "DigitalAltar": {
          "description": "Interactive shrine with 9 planetary deities; tap to chant Beej mantra with count tracker",
          "props_interface": {
            "dominantPlanet": "PlanetId",
            "altarSessions": "AltarSession[]",
            "onMantraChant": "(planet: PlanetId) => void",
            "audioEnabled": "boolean",
            "mantras": "Record<PlanetId, MantraConfig>"
          }
        },
        "DashaTimeline": {
          "description": "Horizontal scrollable Mahadasha/Antardasha/Pratyantar timeline with current position marker",
          "props_interface": {
            "dashas": "DashaPeriod[]",
            "currentDate": "string",
            "onPeriodClick": "(period: DashaPeriod) => void",
            "visibleYearsRange": "[number, number]",
            "showAntardasha": "boolean",
            "showPratyantar": "boolean",
            "isExtendedLocked": "boolean"
          }
        },
        "PlanetTable": {
          "description": "Tabular view of all 9 grahas with sign, house, nakshatra, dignity, and strength scores",
          "props_interface": {
            "planets": "PlanetPosition[]",
            "showStrengthScores": "boolean",
            "showNakshatra": "boolean",
            "highlightedPlanetId": "PlanetId | null",
            "onPlanetClick": "(planet: PlanetPosition) => void",
            "ayanamsa": "'lahiri' | 'raman' | 'krishnamurti'"
          }
        },
        "ForecastCards": {
          "description": "Swipeable cards showing monthly/yearly forecasts per life domain",
          "props_interface": {
            "forecasts": "ForecastCard[]",
            "domain": "'career' | 'relationships' | 'health' | 'finance' | 'spirituality'",
            "visibleMonths": "number",
            "isYearThreeLocked": "boolean",
            "onLockedCardClick": "(forecast: ForecastCard) => void",
            "onDomainChange": "(domain: string) => void"
          }
        },
        "SubscriptionGate": {
          "description": "Overlay/blur gate component that intercepts premium feature access and drives upsell",
          "props_interface": {
            "requiredTier": "SubscriptionTierKey",
            "currentTier": "SubscriptionTierKey",
            "featureName": "string",
            "upsellVariant": "'blur_overlay' | 'bottom_sheet' | 'modal' | 'inline_banner'",
            "ctaText": "string",
            "onUpgradeClick": "() => void",
            "children": "React.ReactNode"
          }
        }
      },
      "chart_engine": {
        "library": "swisseph-wasm",
        "ayanamsa": "Lahiri (Chitrapaksha)",
        "ayanamsa_id": 1,
        "calculation_mode": "client_side",
        "house_system": "Whole Sign",
        "supported_charts": ["D1_Rasi", "D9_Navamsa", "D10_Dashamsa", "D2_Hora", "D3_Drekkana"],
        "planets_calculated": ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn", "Rahu", "Ketu"],
        "extra_points": ["Ascendant", "Midheaven", "Gulika", "Mandi"],
        "wasm_bundle_path": "/static/swisseph.wasm",
        "ephemeris_data_path": "/static/ephe/"
      },
      "animation": {
        "library": "Framer Motion 11",
        "animated_components": {
          "TimeSlider": {
            "animation_type": "spring interpolation on planetary degree scrub",
            "config": { "stiffness": 120, "damping": 20, "mass": 0.8 }
          },
          "HouseHighlight": {
            "animation_type": "SVG fill color transition + scale pulse",
            "config": { "duration": 0.3, "ease": "easeOut" }
          },
          "DashaTimeline": {
            "animation_type": "horizontal scroll with inertia",
            "config": { "type": "spring", "stiffness": 300, "damping": 30 }
          },
          "SubscriptionGate": {
            "animation_type": "blur-in overlay with backdrop fade",
            "config": { "duration": 0.4, "ease": "easeInOut" }
          },
          "GreenRedCalendar": {
            "animation_type": "staggered day-cell reveal on month change",
            "config": { "staggerChildren": 0.015, "delayChildren": 0.05 }
          }
        }
      }
    },
    "backend": {
      "runtime": "Node.js 20 LTS",
      "framework": "Fastify 4.x",
      "language": "TypeScript 5.x",
      "deployment": {
        "platform": "Railway (primary) or Render",
        "containerized": true,
        "dockerfile_base": "node:20-alpine"
      },
      "database": {
        "primary": {
          "engine": "PostgreSQL 16",
          "provider": "Supabase (managed)",
          "use_cases": ["user profiles", "chart metadata", "subscription records", "altar session history", "audit logs"],
          "connection_pool": { "min": 2, "max": 20 }
        },
        "cache": {
          "engine": "Redis 7",
          "provider": "Upstash Redis (serverless)",
          "use_cases": ["session tokens", "green_red_cache (30-day TTL)", "chart_cache (7-day TTL)", "rate limit counters"],
          "ttl_defaults": {
            "session": 86400,
            "green_red_cache": 2592000,
            "chart_cache": 604800,
            "rate_limit_window": 3600
          }
        }
      },
      "auth": {
        "provider": "Supabase Auth",
        "methods": ["Google OAuth 2.0", "Email OTP (magic link)"],
        "jwt_secret_source": "Supabase project JWT secret",
        "session_strategy": "JWT stored in httpOnly cookie + Redis session mirror",
        "row_level_security": true
      },
      "payment": {
        "india_primary": {
          "provider": "Razorpay",
          "supported_methods": ["UPI", "NetBanking", "Cards", "Wallets", "EMI"],
          "webhook_endpoint": "/api/webhooks/razorpay",
          "webhook_secret_env": "RAZORPAY_WEBHOOK_SECRET"
        },
        "international": {
          "provider": "Stripe",
          "supported_methods": ["Cards", "Apple Pay", "Google Pay"],
          "webhook_endpoint": "/api/webhooks/stripe",
          "webhook_secret_env": "STRIPE_WEBHOOK_SECRET"
        }
      },
      "subscription_tables": {
        "users": {
          "columns": {
            "id": "uuid PRIMARY KEY DEFAULT gen_random_uuid()",
            "email": "text UNIQUE NOT NULL",
            "full_name": "text",
            "avatar_url": "text",
            "auth_provider": "text NOT NULL",
            "created_at": "timestamptz DEFAULT now()",
            "updated_at": "timestamptz DEFAULT now()",
            "is_active": "boolean DEFAULT true",
            "referral_code": "text UNIQUE",
            "referred_by": "uuid REFERENCES users(id)"
          }
        },
        "subscriptions": {
          "columns": {
            "id": "uuid PRIMARY KEY DEFAULT gen_random_uuid()",
            "user_id": "uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE",
            "tier": "text NOT NULL CHECK (tier IN ('free', 'dharma_pass', 'jyotishi_pro'))",
            "status": "text NOT NULL CHECK (status IN ('active', 'cancelled', 'past_due', 'trialing'))",
            "payment_provider": "text NOT NULL CHECK (payment_provider IN ('razorpay', 'stripe'))",
            "provider_subscription_id": "text UNIQUE",
            "provider_customer_id": "text",
            "current_period_start": "timestamptz",
            "current_period_end": "timestamptz",
            "cancel_at_period_end": "boolean DEFAULT false",
            "billing_cycle": "text CHECK (billing_cycle IN ('monthly', 'yearly'))",
            "amount_paise": "integer",
            "currency": "text DEFAULT 'INR'",
            "created_at": "timestamptz DEFAULT now()",
            "updated_at": "timestamptz DEFAULT now()"
          }
        },
        "chart_cache": {
          "columns": {
            "id": "uuid PRIMARY KEY DEFAULT gen_random_uuid()",
            "user_id": "uuid REFERENCES users(id) ON DELETE SET NULL",
            "chart_hash": "text UNIQUE NOT NULL",
            "birth_date": "date NOT NULL",
            "birth_time": "time NOT NULL",
            "birth_place": "text NOT NULL",
            "latitude": "numeric(9,6) NOT NULL",
            "longitude": "numeric(9,6) NOT NULL",
            "timezone": "text NOT NULL",
            "chart_json": "jsonb NOT NULL",
            "ayanamsa": "text DEFAULT 'lahiri'",
            "is_public": "boolean DEFAULT false",
            "created_at": "timestamptz DEFAULT now()",
            "expires_at": "timestamptz DEFAULT now() + interval '7 days'"
          }
        },
        "green_red_cache": {
          "columns": {
            "id": "uuid PRIMARY KEY DEFAULT gen_random_uuid()",
            "chart_hash": "text NOT NULL REFERENCES chart_cache(chart_hash) ON DELETE CASCADE",
            "cache_month": "date NOT NULL",
            "days_json": "jsonb NOT NULL",
            "algorithm_version": "text DEFAULT 'v1'",
            "created_at": "timestamptz DEFAULT now()",
            "expires_at": "timestamptz DEFAULT now() + interval '30 days'",
            "UNIQUE": "(chart_hash, cache_month)"
          }
        },
        "altar_sessions": {
          "columns": {
            "id": "uuid PRIMARY KEY DEFAULT gen_random_uuid()",
            "user_id": "uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE",
            "planet": "text NOT NULL CHECK (planet IN ('Sun','Moon','Mars','Mercury','Jupiter','Venus','Saturn','Rahu','Ketu'))",
            "mantra_key": "text NOT NULL",
            "chant_count": "integer NOT NULL DEFAULT 1",
            "session_date": "date NOT NULL DEFAULT CURRENT_DATE",
            "audio_played": "boolean DEFAULT false",
            "created_at": "timestamptz DEFAULT now()"
          }
        }
      },
      "api_routes": [
        {
          "method": "POST",
          "path": "/api/chart/calculate",
          "auth_required": false,
          "rate_limit": "10/hour per IP",
          "description": "Calculate full Kundali from birth details; returns ChartData and chart_hash; caches result in PostgreSQL"
        },
        {
          "method": "GET",
          "path": "/api/chart/:chartHash",
          "auth_required": false,
          "rate_limit": "60/hour",
          "description": "Retrieve cached chart by hash; returns ChartData with subscription-gated fields omitted for free tier"
        },
        {
          "method": "GET",
          "path": "/api/chart/:chartHash/green-red",
          "auth_required": false,
          "rate_limit": "30/hour",
          "query_params": { "month": "YYYY-MM", "days": "7|30" },
          "description": "Fetch green/red day scores for given month; free tier limited to 7 days, full month requires dharma_pass"
        },
        {
          "method": "GET",
          "path": "/api/chart/:chartHash/forecast",
          "auth_required": true,
          "min_tier": "dharma_pass",
          "query_params": { "domain": "career|relationships|health|finance|spirituality", "years": "1|3|5" },
          "description": "Generate domain-specific forecast cards; years 2-5 gated to dharma_pass+"
        },
        {
          "method": "GET",
          "path": "/api/chart/:chartHash/time-slider",
          "auth_required": true,
          "min_tier": "dharma_pass",
          "query_params": { "from": "ISO date", "to": "ISO date", "step_days": "integer" },
          "description": "Generate TimeSliderFrame array for the requested date range"
        },
        {
          "method": "GET",
          "path": "/api/chart/:chartHash/hard-truths",
          "auth_required": true,
          "min_tier": "dharma_pass",
          "description": "Return locked HardTruth items based on chart afflictions and current dasha timing"
        },
        {
          "method": "GET",
          "path": "/api/chart/:chartHash/dashas",
          "auth_required": false,
          "description": "Return full Vimshottari Mahadasha tree with Antardasha and Pratyantar periods"
        },
        {
          "method": "POST",
          "path": "/api/auth/register",
          "auth_required": false,
          "description": "Register new user with email; initiates Supabase OTP flow"
        },
        {
          "method": "POST",
          "path": "/api/auth/verify-otp",
          "auth_required": false,
          "description": "Verify OTP and issue session JWT"
        },
        {
          "method": "POST",
          "path": "/api/auth/google",
          "auth_required": false,
          "description": "Initiate Google OAuth flow via Supabase Auth"
        },
        {
          "method": "POST",
          "path": "/api/auth/logout",
          "auth_required": true,
          "description": "Invalidate session JWT and clear Redis session mirror"
        },
        {
          "method": "GET",
          "path": "/api/user/profile",
          "auth_required": true,
          "description": "Fetch authenticated user profile and active subscription tier"
        },
        {
          "method": "PATCH",
          "path": "/api/user/profile",
          "auth_required": true,
          "description": "Update user display name or avatar"
        },
        {
          "method": "GET",
          "path": "/api/user/charts",
          "auth_required": true,
          "description": "List saved charts for the authenticated user"
        },
        {
          "method": "POST",
          "path": "/api/user/charts/:chartHash/save",
          "auth_required": true,
          "description": "Associate a chart hash with the authenticated user account"
        },
        {
          "method": "POST",
          "path": "/api/subscriptions/create-order",
          "auth_required": true,
          "body": { "tier": "dharma_pass|jyotishi_pro", "cycle": "monthly|yearly", "provider": "razorpay|stripe" },
          "description": "Create a Razorpay order or Stripe PaymentIntent and return client secret/order_id"
        },
        {
          "method": "POST",
          "path": "/api/subscriptions/verify-payment",
          "auth_required": true,
          "description": "Verify Razorpay payment signature post-checkout and activate subscription"
        },
        {
          "method": "POST",
          "path": "/api/subscriptions/cancel",
          "auth_required": true,
          "description": "Set cancel_at_period_end = true on active subscription"
        },
        {
          "method": "GET",
          "path": "/api/subscriptions/status",
          "auth_required": true,
          "description": "Return current subscription tier, status, and next billing date"
        },
        {
          "method": "POST",
          "path": "/api/webhooks/razorpay",
          "auth_required": false,
          "description": "Handle Razorpay webhook events (payment.captured, subscription.charged, subscription.cancelled)"
        },
        {
          "method": "POST",
          "path": "/api/webhooks/stripe",
          "auth_required": false,
          "description": "Handle Stripe webhook events (invoice.paid, customer.subscription.deleted)"
        },
        {
          "method": "POST",
          "path": "/api/altar/chant",
          "auth_required": true,
          "min_tier": "free",
          "body": { "planet": "PlanetId", "count": "integer" },
          "description": "Record altar mantra chant session; increments daily chant counter"
        },
        {
          "method": "GET",
          "path": "/api/altar/sessions",
          "auth_required": true,
          "query_params": { "days": "integer default 30" },
          "description": "Retrieve altar session history with per-planet chant totals"
        },
        {
          "method": "GET",
          "path": "/api/altar/mantras",
          "auth_required": false,
          "description": "Return mantra config for all 9 planets including CDN audio URLs"
        },
        {
          "method": "GET",
          "path": "/api/health",
          "auth_required": false,
          "description": "Health check endpoint returning service status and DB connectivity"
        }
      ]
    },
    "data_models": {
      "ChartData": {
        "description": "Core Kundali data contract — VedaVision extended version",
        "schema": {
          "chartHash": "string",
          "version": "string",
          "calculatedAt": "string (ISO 8601)",
          "input": {
            "birthDate": "string (YYYY-MM-DD)",
            "birthTime": "string (HH:MM:SS)",
            "birthPlace": "string",
            "latitude": "number",
            "longitude": "number",
            "timezone": "string (IANA tz)",
            "ayanamsa": "string ('lahiri')"
          },
          "ascendant": {
            "sign": "string",
            "signIndex": "number (0-11)",
            "degree": "number",
            "nakshatra": "string",
            "nakshatraPada": "number (1-4)"
          },
          "planets": {
            "type": "array",
            "items": {
              "id": "PlanetId ('Sun'|'Moon'|'Mars'|'Mercury'|'Jupiter'|'Venus'|'Saturn'|'Rahu'|'Ketu')",
              "sign": "string",
              "signIndex": "number (0-11)",
              "house": "number (1-12)",
              "degree": "number (0-30)",
              "absoluteDegree": "number (0-360)",
              "nakshatra": "string",
              "nakshatraPada": "number (1-4)",
              "isRetrograde": "boolean",
              "isCombust": "boolean",
              "dignity": "'exalted'|'moolatrikona'|'own'|'friendly'|'neutral'|'enemy'|'debilitated'",
              "shadbala": "number",
              "ashtakavarga": "number (0-8)"
            }
          },
          "houses": {
            "type": "array",
            "items": {
              "number": "number (1-12)",
              "sign": "string",
              "signIndex": "number (0-11)",
              "lord": "PlanetId",
              "occupants": "PlanetId[]",
              "ashtakavargaScore": "number"
            }
          },
          "dashas": {
            "current_mahadasha": {
              "planet": "PlanetId",
              "start": "string (ISO date)",
              "end": "string (ISO date)",
              "current_antardasha": {
                "planet": "PlanetId",
                "start": "string (ISO date)",
                "end": "string (ISO date)",
                "current_pratyantar": {
                  "planet": "PlanetId",
                  "start": "string (ISO date)",
                  "end": "string (ISO date)"
                }
              }
            },
            "full_tree": "DashaPeriod[]"
          },
          "yogas": {
            "classical": "Yoga[]",
            "bnn_yogas": {
              "description": "Bhrigu Nandi Nadi extended yoga set — VedaVision extension",
              "items": {
                "type": "array",
                "schema": {
                  "yogaId": "string",
                  "name": "string",
                  "domain": "'wealth'|'career'|'relationships'|'health'|'spirituality'",
                  "strength": "number (0-100)",
                  "activationDasha": "PlanetId[]",
                  "description": "string",
                  "remedies": "string[]"
                }
              }
            }
          },
          "wealth_score": {
            "total": "number (0-100)",
            "parashari_component": "number (0-60)",
            "bnn_component": "number (0-40)",
            "breakdown": {
              "dhan_yogas_count": "number",
              "second_house_strength": "number",
              "eleventh_house_strength": "number",
              "jupiter_strength": "number",
              "venus_strength": "number",
              "active_dasha_multiplier": "number"
            }
          },
          "green_red_score": {
            "description": "Precomputed 30-day auspiciousness baseline — VedaVision extension",
            "baseline": "number (0-100)",
            "primary_benefics": "PlanetId[]",
            "primary_malefics": "PlanetId[]",
            "sensitivity_factors": "string[]"
          },
          "hard_truths_locked": {
            "description": "Gated assessment flags — VedaVision extension",
            "has_afflicted_seventh": "boolean",
            "has_afflicted_fifth": "boolean",
            "has_shani_sade_sati": "boolean",
            "has_kaal_sarp_dosha": "boolean",
            "has_mangal_dosha": "boolean",
            "career_switch_window_active": "boolean",
            "antardasha_warning_active": "boolean",
            "hard_truths_count": "number"
          }
        }
      },
      "TimeSliderFrame": {
        "description": "Single animation frame for Time Slider scrub (skill.md Section 9.3)",
        "schema": {
          "isoDate": "string",
          "julianDay": "number",
          "ascendantDegree": "number",
          "planets": {
            "type": "array",
            "items": {
              "id": "PlanetId",
              "absoluteDegree": "number",
              "house": "number",
              "isRetrograde": "boolean",
              "transitingHouse": "number"
            }
          },
          "activeDasha": {
            "mahadasha": "PlanetId",
            "antardasha": "PlanetId",
            "pratyantar": "PlanetId | null"
          },
          "keyEvent": {
            "type": "null | 'dasha_change' | 'eclipse' | 'saturn_return' | 'jupiter_return'",
