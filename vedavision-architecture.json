      "green_red_algorithm": {
        "description": "Weighted Panchanga + personal Dasha scoring per skill.md Section 9.2",
        "algorithm_version": "v1",
        "total_weight": 100,
        "panchanga_factors": {
          "tithi": { "weight": 20, "source": "Moon elongation from Sun (0-360° / 12°)", "auspicious_tithis": [1,2,3,5,7,10,11,13], "inauspicious_tithis": [4,6,8,9,12,14,30] },
          "vara": { "weight": 10, "auspicious_varas": ["Wednesday", "Thursday", "Friday"], "neutral_varas": ["Monday", "Sunday"], "inauspicious_varas": ["Tuesday", "Saturday"] },
          "nakshatra": { "weight": 15, "auspicious_nakshatras": ["Ashwini","Rohini","Mrigashira","Punarvasu","Pushya","Hasta","Chitra","Swati","Anuradha","Mula","Uttara Phalguni","Uttara Ashadha","Uttara Bhadrapada","Revati"], "inauspicious_nakshatras": ["Bharani","Krittika","Ardra","Ashlesha","Magha","Vishakha","Jyeshtha","Shatabhisha"] },
          "yoga": { "weight": 10, "auspicious_yogas": ["Siddhi","Amrita","Shubha","Shukla","Brahma","Indra","Vaidhriti_avoided"], "inauspicious_yogas": ["Vishkambha","Atiganda","Vyaghata","Parigha","Vajra","Vaidhriti"] },
          "karana": { "weight": 5, "auspicious_karanas": ["Bava","Balava","Kaulava","Taitila","Gara","Vanija"], "inauspicious_karanas": ["Vishti (Bhadra)"] }
        },
        "personal_dasha_factor": {
          "weight": 25,
          "logic": "Score based on natal benefic/malefic designation of Mahadasha lord (±15) + Antardasha lord (±10) for the individual chart"
        },
        "moon_transit_factor": {
          "weight": 15,
          "logic": "Transiting Moon's relationship to natal Moon and Ascendant (trine/sextile = +15, square/opposition = -15, conjunction = variable)"
        },
        "cache_strategy": "Pre-compute full month on first request; store in green_red_cache table with 30-day Redis TTL"
      },
